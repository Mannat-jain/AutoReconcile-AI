# ─────────────────────────────────────────────────────────────
# AutoReconcile AI — environment configuration
# Copy this file to backend/.env and frontend/.env.local and fill
# in real values only if you want to leave MOCK MODE. The project
# runs fully offline with zero keys configured.
# ─────────────────────────────────────────────────────────────

# --- Backend (backend/.env) ---------------------------------------------

# OpenAI API key for the optional LLM (GPT-4o, text-based) invoice extraction path.
# Leave empty to use the built-in deterministic OCR/regex extractor —
# the demo is fully functional without this.
OPENAI_API_KEY=

# RazorpayX Payouts API credentials. Leave BOTH empty to keep the
# payout service in MOCK MODE (simulates realistic responses with zero
# network calls — safe for demos/interviews).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_ACCOUNT_NUMBER=

# Tunables (all optional; defaults shown)
# AUTO_PAYOUT_CONFIDENCE=0.95      # autonomous payout only when confidence is strictly above this
# AMOUNT_TOLERANCE=0.005           # relative invoice-vs-settlement difference tolerated (0.5%)
# ALLOWED_ORIGINS=http://localhost:3000   # comma-separated CORS origins
# AUDIT_LOG_PATH=backend/data/payout_audit_log.jsonl
# PAYOUT_DB_PATH=backend/data/payouts.db
# MOCK_LATENCY_SECONDS=0.15

# --- Frontend (frontend/.env.local) --------------------------------------

# Base URL of the FastAPI backend the Next.js app talks to.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
