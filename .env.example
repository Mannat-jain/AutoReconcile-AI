# ─────────────────────────────────────────────────────────────
# AutoReconcile AI — environment configuration
# Copy this file to backend/.env and frontend/.env.local and fill
# in real values only if you want to leave MOCK MODE. The project
# runs fully offline with zero keys configured.
# ─────────────────────────────────────────────────────────────

# --- Backend (backend/.env) ---------------------------------------------

# OpenAI API key for the Vision-LLM (GPT-4o) invoice extraction path.
# Leave empty to use the built-in deterministic OCR/regex extractor —
# the demo is fully functional without this.
OPENAI_API_KEY=

# RazorpayX Payouts API credentials. Leave BOTH empty to keep the
# payout service in MOCK MODE (simulates realistic responses with zero
# network calls — safe for demos/interviews).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_ACCOUNT_NUMBER=

# --- Frontend (frontend/.env.local) --------------------------------------

# Base URL of the FastAPI backend the Next.js app talks to.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
